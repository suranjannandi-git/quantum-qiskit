   "source": [
    "## Parameter Expression\n",
    "https://quantum.cloud.ibm.com/docs/en/api/qiskit/qiskit.circuit.ParameterExpression"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "da0aab13",
   "metadata": {},
   "outputs": [],
   "source": [
    "from qiskit.circuit import Parameter\n",
    "\n",
    "x, y = Parameter(\"x\"), Parameter(\"y\")\n",
    "left = x + y + 1\n",
    "right = 1 + y + x\n",
    "assert left == right\n",
    "assert not left.structurally_equal(right)"
   ]
  }
 ],
